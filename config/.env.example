# ==========================================
# CONFIGURAÇÕES GERAIS DO PROJETO
# ==========================================

# Gateway Node.js & Dashboard
PORT=3000
NODE_ENV=development
DASHBOARD_PASS=admin123

# Motor de IA (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# Chaves de API de Provedores de IA
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.7-flash

# Configurações do Bot WhatsApp
BOT_NAME="Assistente Virtual"
TRIGGER_PREFIX=!
RESPOND_GROUPS=false
RESPOND_PRIVATE=true
